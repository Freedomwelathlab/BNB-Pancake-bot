{
  "name": "bnb-snipping-bot",
  "version": "0.1.0",
  "description": "Evidence-gated BNB Chain trading bot. Paper mode by default.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "backtest": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/backtest.ts",
    "fetch-history": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/fetchHistory.ts",
    "fetch-history-solana": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/fetchHistorySolana.ts",
    "status": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/status.ts",
    "kill": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/killswitch.ts",
    "check-token": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/checkToken.ts",
    "wallet": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/wallet.ts",
    "telegram-setup": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx scripts/telegramSetup.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "viem": "^2.58.0",
    "zod": "^3.25.76",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
