# ---------------------------------------------------------------------------
# BNB Edge Bot configuration. Copy to .env and edit. NEVER commit .env.
# Defaults are SAFE: paper mode, tiny sizes, live trading off.
# ---------------------------------------------------------------------------

# --- Mode -------------------------------------------------------------------
# Live trading needs ALL of: MODE=live, LIVE_TRADING_ENABLED=true, the exact
# LIVE_CONFIRM phrase below, a key file, AND a passing evidence gate
# (fresh out-of-sample report + >=30 profitable paper trades). Otherwise: paper.
MODE=paper
LIVE_TRADING_ENABLED=false
# Exact phrase required for live: I ACCEPT THAT I CAN LOSE ALL FUNDS IN THIS HOT WALLET
LIVE_CONFIRM=
# Hot-wallet private key is read from a file (Docker secret), never from this file.
PRIVATE_KEY_FILE=/run/secrets/hot_wallet_key

# --- RPC --------------------------------------------------------------------
# Several HTTP endpoints = automatic failover. Public endpoints are rate-limited
# (bnbchain.org: 10K requests / 5 min, eth_getLogs disabled). A paid/free-tier
# provider key (NodeReal, QuickNode, Ankr, Chainstack...) is recommended for live.
RPC_HTTP_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-rpc.publicnode.com,https://bsc-dataseed1.defibit.io
RPC_WS_URLS=wss://bsc-rpc.publicnode.com
LOG_RPC_URL=https://bsc-rpc.publicnode.com

# --- Strategies -------------------------------------------------------------
# pullback | breakout (established pools). postgrad is research-only (recorded, not traded).
STRATEGIES=pullback,breakout
# Record every Four.meme launch and graduation (research data; never trades the curve)
WATCH_FOUR_MEME=true
# Optional fixed token list (comma-separated addresses). Empty = data/history/_universe.json
UNIVERSE=

# --- Capital limits (BNB) ---------------------------------------------------
MAX_TRADE_BNB=0.02
MAX_OPEN_POSITIONS=2
MAX_CAPITAL_AT_RISK_BNB=0.05
DAILY_LOSS_CAP_BNB=0.01
MIN_WALLET_RESERVE_BNB=0.005
PAPER_START_BNB=0.2

# --- Execution guards -------------------------------------------------------
MAX_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_BPS=100
MAX_GAS_GWEI=1
TX_DEADLINE_SEC=30
HURDLE_MARGIN=1.5
MAX_CONSECUTIVE_FAILURES=3

# --- Market / safety filters ------------------------------------------------
MIN_LIQUIDITY_USD=150000
MIN_POOL_AGE_DAYS=30
MAX_TAX_PCT=0
MAX_TOP10_HOLDER_PCT=60
MIN_SAFETY_SCORE=70

# --- Exits (used only until a backtest report supplies tested exits) --------
HARD_STOP_PCT=4
TRAIL_ACTIVATE_PCT=3
TRAIL_PCT=2.5
TAKE_PROFIT_PCT=6
TAKE_PROFIT_FRACTION=0.5
MAX_HOLD_MINUTES=720
ILLIQUIDITY_DROP_PCT=40

# --- Evidence gate ----------------------------------------------------------
EVIDENCE_REPORT=./reports/latest-evaluation.json
EVIDENCE_MAX_AGE_DAYS=14
MIN_PAPER_TRADES_FOR_LIVE=30

# --- Infra ------------------------------------------------------------------
DB_PATH=./data/bot.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Long random string, e.g. `openssl rand -hex 24`
DASHBOARD_TOKEN=
# Telegram alerts (optional): create a bot with @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POLL_SECONDS=60
LOG_LEVEL=info
